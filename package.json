{
  "name": "caffeine-streamdeck",
  "version": "0.1.0",
  "description": "Stream Deck plugin to toggle macOS sleep prevention via caffeinate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=esm --outfile=com.klein2ms.caffeine.sdPlugin/plugin.js --external:@elgato/streamdeck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
